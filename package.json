{
  "name": "pbb-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Pashtoonkhwa Blood Bank & Welfare Society - operational platform + public site",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node init && pnpm -r --parallel dev",
    "build": "node init && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "pnpm --filter @pbb/web test:e2e",
    "check:supabase": "node scripts/check-supabase.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  }
}
