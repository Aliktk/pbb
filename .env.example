# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pbb:pbb_dev_password@localhost:5432/pbb?schema=public"
# App-level role used at runtime (has no UPDATE/DELETE on audit_log — see migrations)
DATABASE_APP_URL="postgresql://pbb_app:pbb_app_password@localhost:5432/pbb?schema=public"

# ── Redis (cache + BullMQ queues) ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-32-chars-minimum-value"
JWT_REFRESH_SECRET="change-me-refresh-32-chars-minimum-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
ARGON2_MEMORY_KiB=19456
TOTP_ISSUER="Pashtoonkhwa Blood Bank"

# ── Notifications (behind NotificationPort — provider will change) ──────────
NOTIFICATIONS_DRIVER="console"          # console | twilio  (console = dev, logs only)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
WHATSAPP_ENABLED="false"                # flag: WhatsApp disabled until number approved
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""

# ── Storage (S3-compatible: media + consent forms) ─────────────────────────
STORAGE_DRIVER="local"                  # local | s3
S3_ENDPOINT=""
S3_BUCKET="pbb-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── Web ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
API_PORT=4000
WEB_PORT=3000

# ── Ops ────────────────────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC_PER_MIN=20
SCREENING_STALE_DAYS=180
DONATION_COOLDOWN_DAYS=90
STOCK_STALE_HOURS=48
